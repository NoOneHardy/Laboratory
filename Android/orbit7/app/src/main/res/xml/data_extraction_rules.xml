<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is a file the user exports themselves; nothing is copied off the device automatically. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
