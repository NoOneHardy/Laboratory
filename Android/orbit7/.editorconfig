# Formatting is not a review topic (docs/06-test-strategy.md §2). Spotless, ktlint and the IDE all
# read this file, so what CI enforces is what the editor produces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# @Composable functions are PascalCase by convention.
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
